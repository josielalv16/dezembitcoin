{
  "name": "dezembitcoin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build && wrangler deploy --dry-run",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
